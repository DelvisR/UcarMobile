# This is the root EditorConfig file
root = true

# =========================================================
# General rules for all text files
# =========================================================
[*]
charset = utf-8                      # Use UTF-8 encoding
end_of_line = lf                     # Use LF line endings by default
insert_final_newline = true           # Ensure file ends with a newline
trim_trailing_whitespace = true       # Remove trailing whitespace automatically
indent_style = space                  # Use spaces instead of tabs
indent_size = 4                       # Default indent size

# =========================================================
# C# source files
# =========================================================
[*.cs]
indent_style = space                  # Spaces for indentation
indent_size = 4                       # 4-space indent for C#
dotnet_sort_system_directives_first = true   # Sort System.* usings first
csharp_new_line_before_open_brace = all      # New line before every opening brace
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = flush_left

# =========================================================
# Project files (.csproj)
# =========================================================
[*.csproj]
indent_style = space
indent_size = 2                       # 2-space indent for XML-style project files

# =========================================================
# JSON files (includes launchSettings.json and appsettings.json)
# =========================================================
[*.json]
indent_style = space
indent_size = 2                       # 2-space indent for JSON
trim_trailing_whitespace = true
insert_final_newline = true

# =========================================================
# XML configuration files
# =========================================================
[*.xml]
indent_style = space
indent_size = 2

[*.config]
indent_style = space
indent_size = 2

# =========================================================
# Solution file (.sln)
# =========================================================
[*.sln]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# =========================================================
# XAML and Razor views
# =========================================================
[*.xaml]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.cshtml]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# =========================================================
# YAML files (CI/CD pipelines, docker-compose, etc.)
# =========================================================
[*.yml]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.yaml]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# =========================================================
# Dockerfiles
# =========================================================
[Dockerfile*]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# =========================================================
# SQL scripts
# =========================================================
[*.sql]
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

# =========================================================
# Resource files
# =========================================================
[*.resx]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

# =========================================================
# Markdown and plain text files
# =========================================================
[*.md]
trim_trailing_whitespace = false      # Keep trailing spaces in Markdown (used for hard line breaks)

[*.txt]
indent_style = space
indent_size = 2

# =========================================================
# Windows scripts (use CRLF line endings)
# =========================================================
[*.ps1]
end_of_line = crlf                    # PowerShell uses CRLF on Windows

[*.bat]
end_of_line = crlf                    # Batch files also use CRLF on Windows

# ===============================================
# C# var preferences
# ===============================================
# Always use 'var' for built-in types (int, string, bool, etc.)
dotnet_style_var_for_built_in_types = true:suggestion

# Always use 'var' when the type is obvious from the right-hand side
dotnet_style_var_when_type_is_apparent = true:suggestion

# Always use 'var' in all other cases
dotnet_style_var_elsewhere = true:suggestion