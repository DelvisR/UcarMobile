<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" ReportInfo.Created="01/23/2026 12:41:21" ReportInfo.Modified="01/28/2026 17:31:40" ReportInfo.CreatorVersion="2026.1.0.0">
  <Dictionary>
    <BusinessObjectDataSource Name="Appointment" ReferenceName="Appointment" DataType="System.Int32" Enabled="true">
      <Column Name="Id" DataType="System.Int32"/>
      <Column Name="ClientId" DataType="System.Int32"/>
      <Column Name="ClientEmail" DataType="System.String"/>
      <Column Name="ClientPhone" DataType="System.String"/>
      <Column Name="ClientFullName" DataType="System.String"/>
      <Column Name="ScheduledStart" Enabled="false" DataType="System.DateTime"/>
      <Column Name="CompletedAt" Enabled="false" DataType="System.DateTime"/>
      <Column Name="ServiceFullAddress" DataType="System.String"/>
      <Column Name="ServiceAddressLat" Enabled="false" DataType="System.Double"/>
      <Column Name="ServiceAddressLng" Enabled="false" DataType="System.Double"/>
      <Column Name="EstimatedTotal" DataType="System.Decimal"/>
      <Column Name="Tax" DataType="System.Decimal"/>
      <Column Name="Discount" DataType="System.Decimal"/>
      <Column Name="WarrantyMonths" DataType="System.Int32"/>
      <Column Name="WarrantyMiless" Alias="WarrantyMiles" DataType="System.Int32"/>
      <BusinessObjectDataSource Name="Vehicles" ReferenceName="Vehicles" DataType="System.Int32" Enabled="true">
        <Column Name="OdometerKm" DataType="System.Int32"/>
        <Column Name="VehicleName" DataType="System.String"/>
        <Column Name="VehicleVIN" DataType="System.String"/>
        <Column Name="VehicleLicense" DataType="System.String"/>
        <Column Name="TechnicianId" DataType="System.Int32"/>
        <Column Name="TechnicianName" DataType="System.String"/>
        <BusinessObjectDataSource Name="Services" ReferenceName="Services" DataType="System.Int32" Enabled="true">
          <Column Name="Id" Enabled="false" DataType="System.Int32"/>
          <Column Name="ServiceId" Enabled="false" DataType="System.Int32"/>
          <Column Name="ServiceCategory" Enabled="false" DataType="System.String"/>
          <Column Name="ServiceName" DataType="System.String"/>
          <Column Name="IsWarrantyApplicable" DataType="System.Boolean"/>
          <Column Name="Price" DataType="System.Decimal"/>
          <BusinessObjectDataSource Name="Parts" ReferenceName="Parts" DataType="System.Int32" Enabled="true">
            <Column Name="Id" Enabled="false" DataType="System.Int32"/>
            <Column Name="PartName" DataType="System.String"/>
            <Column Name="PartNumber" Enabled="false" DataType="System.String"/>
            <Column Name="Quantity" DataType="System.Int32"/>
            <Column Name="UnitPrice" DataType="System.Decimal"/>
            <Column Name="IsCustomerProvidedPart" DataType="System.Boolean"/>
            <Column Name="Note" Enabled="false" DataType="System.String"/>
            <Column Name="PartTotal" DataType="System.Decimal" PropName="Column" Calculated="true" Expression="Round([Appointment.Vehicles.Services.Parts.Quantity]*[Appointment.Vehicles.Services.Parts.UnitPrice])"/>
          </BusinessObjectDataSource>
        </BusinessObjectDataSource>
        <Column Name="VehicleTotal" DataType="System.Decimal" PropName="Column" Calculated="true" Expression="[ServicesTotal]+[PartsTotal]"/>
      </BusinessObjectDataSource>
      <Column Name="Email" DataType="System.String" PropName="Column" Calculated="true" Expression="&quot;Email: &quot; + [CompanyEmail]"/>
      <Column Name="Phone" DataType="System.String" PropName="Column" Calculated="true" Expression="&quot;Phone: &quot; + [CompanyPhone]"/>
      <Column Name="ClientCell" DataType="System.Single" PropName="Column" Calculated="true" Expression="&quot;(&quot; + Substring([Appointment.ClientPhone],0,3) + &quot;) &quot; + Substring([Appointment.ClientPhone],3,3) + &quot;-&quot; + Substring([Appointment.ClientPhone],6)"/>
      <Column Name="Warranty" DataType="System.String" PropName="Column" Calculated="true" Expression="[Appointment.WarrantyMonths] + &quot; MONTH/&quot; + Format(&quot;{0:#,000}&quot;,[Appointment.WarrantyMiles]) + &quot; MILE SERVICE WARRANTY&quot;"/>
      <Column Name="WarrantyUntil" DataType="System.String" PropName="Column" Calculated="true" Expression="Format(&quot;{0:MMM dd, yyyy}&quot;, AddMonths([DateOfService],[Appointment.WarrantyMonths])) + &quot; or &quot; + IIf([VehiclesCount]==1,Format(&quot;{0:#,00}&quot;,[OdometerTotal]+[Appointment.WarrantyMiles]),&quot;Vehicle Odometer + &quot; + Format(&quot;{0:#,00}&quot;,[Appointment.WarrantyMiles])) + &quot; Miles&quot;"/>
    </BusinessObjectDataSource>
    <Parameter Name="CompanyName" DataType="System.String" AsString=""/>
    <Parameter Name="CompanyAddress" DataType="System.String" AsString=""/>
    <Parameter Name="CompanyPhone" DataType="System.String" AsString=""/>
    <Parameter Name="CompanyEmail" DataType="System.String" AsString=""/>
    <Parameter Name="CompanyWeb" DataType="System.String" AsString=""/>
    <Parameter Name="DateOfService" DataType="System.DateTime" AsString=""/>
    <Parameter Name="InvoiceNro" DataType="System.String" AsString=""/>
    <Total Name="PartsTotal" Expression="[Appointment.Vehicles.Services.Parts.PartTotal]" Evaluator="Data3"/>
    <Total Name="ServicesTotal" Expression="[Appointment.Vehicles.Services.Price]" Evaluator="Data2"/>
    <Total Name="VehiclesCount" TotalType="Count" Evaluator="Data1"/>
    <Total Name="OdometerTotal" Expression="[Appointment.Vehicles.OdometerKm]" Evaluator="Data1"/>
  </Dictionary>
